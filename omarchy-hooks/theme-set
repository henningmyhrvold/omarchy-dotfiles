#!/usr/bin/env bash
# Omarchy invokes hooks with bash, regardless of the shebang.
set -euo pipefail
python <<'PY'
"""Persistent terminal preferences; Omarchy owns the generated theme colors."""

from datetime import datetime
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile


def apply():
    home = Path.home()
    config = home / ".config/ghostty/config"
    if not config.exists() and not shutil.which("ghostty"):
        print("Ghostty not installed; terminal preferences will apply after installation.")
        return
    config = config.resolve()
    stock = Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")) / "config/ghostty/config"
    old = config.read_text() if config.exists() else stock.read_text()
    begin, end = "# >>> user-overrides >>>", "# <<< user-overrides <<<"
    if old.count(begin) != old.count(end) or old.count(begin) > 1:
        raise ValueError("Malformed Ghostty user-overrides block")
    base = re.sub(re.escape(begin) + r".*?" + re.escape(end) + r"\n?", "", old, flags=re.S)
    preferences = [
        "window-decoration = none",
        "window-padding-x = 18",
        "window-padding-y = 14",
        "background-opacity = 0.95",
        "font-size = 11",
    ]
    # A fresh stock install has bash; don't make Ghostty launch a missing shell.
    if shutil.which("zsh"):
        preferences.append("command = zsh")
    updated = base.rstrip() + "\n\n" + begin + "\n" + "\n".join(preferences) + "\n" + end + "\n"
    if updated == old:
        return
    config.parent.mkdir(parents=True, exist_ok=True)
    if config.exists():
        backup = config.with_name(f".config.backup-{datetime.now():%Y%m%d-%H%M%S-%f}")
        shutil.copy2(config, backup)
        print(f"Backup: {backup}")
    fd, temporary = tempfile.mkstemp(dir=config.parent, prefix=".config.")
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(updated)
        os.chmod(temporary, config.stat().st_mode & 0o777 if config.exists() else 0o644)
        os.replace(temporary, config)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    # Theme hooks run AFTER Omarchy's terminal reload; reload again if we edited.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["omarchy", "restart", "terminal"], check=True)
    print(f"Changed: {config}")


if __name__ == "__main__":
    apply()
PY
